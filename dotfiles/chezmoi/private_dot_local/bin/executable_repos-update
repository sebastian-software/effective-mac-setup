#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: repos-update [--jobs N] [root]

Find Git worktrees below root, skip repos with uncommitted files, check out
"main" where it is available, and update the repositories in parallel.

Options:
  -j, --jobs N  Maximum concurrent repositories (default: up to 8 CPUs).

Set REPOS_UPDATE_JOBS to change the default concurrency.
EOF
}

default_jobs() {
  local cpu_count

  if command -v sysctl >/dev/null 2>&1; then
    cpu_count="$(sysctl -n hw.ncpu 2>/dev/null || true)"
  elif command -v getconf >/dev/null 2>&1; then
    cpu_count="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
  fi

  if [[ ! "${cpu_count:-}" =~ ^[1-9][0-9]*$ ]]; then
    cpu_count=4
  fi

  # A large workspace can contain hundreds of repositories.  Eight concurrent
  # fetches keep the update fast without needlessly overwhelming the network.
  if (( cpu_count > 8 )); then
    cpu_count=8
  fi

  printf '%s\n' "$cpu_count"
}

jobs="${REPOS_UPDATE_JOBS:-$(default_jobs)}"
root="."
root_set=false

while (( $# > 0 )); do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -j|--jobs)
      if (( $# < 2 )); then
        echo "repos-update: missing value for $1" >&2
        exit 2
      fi
      jobs="$2"
      shift 2
      ;;
    --jobs=*)
      jobs="${1#*=}"
      shift
      ;;
    --)
      shift
      if (( $# > 1 )) || [[ "$root_set" == true && $# -eq 1 ]]; then
        echo "repos-update: expected at most one root directory" >&2
        exit 2
      fi
      if (( $# == 1 )); then
        root="$1"
      fi
      break
      ;;
    -*)
      echo "repos-update: unknown option: $1" >&2
      exit 2
      ;;
    *)
      if [[ "$root_set" == true ]]; then
        echo "repos-update: expected at most one root directory" >&2
        exit 2
      fi
      root="$1"
      root_set=true
      shift
      ;;
  esac
done

if [[ ! "$jobs" =~ ^[1-9][0-9]*$ ]]; then
  echo "repos-update: jobs must be a positive integer: $jobs" >&2
  exit 2
fi

if [[ ! -d "$root" ]]; then
  echo "repos-update: root does not exist: $root" >&2
  exit 2
fi

root="$(cd "$root" && pwd)"

update_repository() {
  local worktree="$1"
  local label="$2"
  local status remote main_ref current_branch

  printf -- '- Updating: %s\n' "$label"

  if ! status="$(git -C "$worktree" status --porcelain=v1 --untracked-files=normal)"; then
    printf '  failed: could not inspect working tree\n' >&2
    return 1
  fi

  # This includes untracked files: checking out another branch could otherwise
  # overwrite a file that has not been committed yet.
  if [[ -n "$status" ]]; then
    printf '  skipped: working tree has uncommitted or untracked files\n' >&2
    return 0
  fi

  if ! git -C "$worktree" show-ref --verify --quiet refs/heads/main; then
    main_ref=""
    for remote in $(git -C "$worktree" remote); do
      if git -C "$worktree" show-ref --verify --quiet "refs/remotes/$remote/main"; then
        main_ref="$remote/main"
        break
      fi
    done

    # A freshly cloned or older checkout may not have a local main branch yet.
    # Fetch the conventional remote once before deciding that main is absent.
    if [[ -z "$main_ref" ]] && git -C "$worktree" remote get-url origin >/dev/null 2>&1; then
      if ! git -C "$worktree" fetch --prune origin; then
        printf '  failed: could not fetch origin while looking for main\n' >&2
        return 1
      fi
      if git -C "$worktree" show-ref --verify --quiet refs/remotes/origin/main; then
        main_ref="origin/main"
      fi
    fi

    if [[ -n "$main_ref" ]]; then
      printf '  checking out main (tracking %s)\n' "$main_ref"
      if ! git -C "$worktree" checkout --quiet -b main --track "$main_ref"; then
        printf '  failed: could not create local main branch\n' >&2
        return 1
      fi
    fi
  fi

  if git -C "$worktree" show-ref --verify --quiet refs/heads/main; then
    current_branch="$(git -C "$worktree" symbolic-ref --quiet --short HEAD || true)"
    if [[ "$current_branch" != "main" ]]; then
      printf '  checking out main\n'
      if ! git -C "$worktree" checkout --quiet main; then
        printf '  skipped: main cannot be checked out safely\n' >&2
        return 0
      fi
    fi
  else
    printf '  main is not available; keeping the current branch\n'
  fi

  if ! git -C "$worktree" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
    printf '  skipped: current branch has no upstream\n' >&2
    return 0
  fi

  if ! git -C "$worktree" pull --ff-only; then
    printf '  failed: fast-forward update was not possible\n' >&2
    return 1
  fi
}

worktrees=()
labels=()
while IFS= read -r -d '' git_path; do
  if [[ -d "$git_path" ]]; then
    worktree="${git_path%/.git}"
  else
    worktree="$(dirname "$git_path")"
  fi
  worktrees+=("$worktree")
  if [[ "$worktree" == "$root" ]]; then
    labels+=(".")
  else
    labels+=("${worktree#$root/}")
  fi
done < <(find "$root" -maxdepth 4 \( -type d -name .git -prune -print0 -o -type f -name .git -print0 \))

if (( ${#worktrees[@]} == 0 )); then
  echo "repos-update: no Git worktrees found below $root"
  exit 0
fi

temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/repos-update.XXXXXX")"
trap 'rm -rf "$temp_dir"' EXIT

pids=()
outputs=()
results=()
next_to_wait=0

for index in "${!worktrees[@]}"; do
  output="$temp_dir/$index"
  update_repository "${worktrees[$index]}" "${labels[$index]}" >"$output" 2>&1 &
  pids[$index]=$!
  outputs[$index]="$output"

  if (( index - next_to_wait + 1 >= jobs )); then
    if wait "${pids[$next_to_wait]}"; then
      results[$next_to_wait]=0
    else
      results[$next_to_wait]=1
    fi
    ((next_to_wait += 1))
  fi
done

for (( index = next_to_wait; index < ${#worktrees[@]}; index += 1 )); do
  if wait "${pids[$index]}"; then
    results[$index]=0
  else
    results[$index]=1
  fi
done

failures=0
for index in "${!worktrees[@]}"; do
  cat "${outputs[$index]}"
  failures=$((failures + results[$index]))
done

if (( failures > 0 )); then
  printf 'repos-update: %d repository update(s) failed\n' "$failures" >&2
  exit 1
fi
